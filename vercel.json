{
  "buildCommand": "echo 'Static site with serverless functions'",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "destination": "/home/home.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
